<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <RootNamespace>SecretNest.ImageStore</RootNamespace>
    <AssemblyName>ImageStore</AssemblyName>
    <!-- The module is loaded by Import-Module, so it needs the full dependency
         closure and a deps.json next to it, the way an application gets one. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- Assembly metadata, previously hand-written in Properties/AssemblyInfo.cs.
       Letting the SDK generate these matters beyond tidiness: with
       GenerateAssemblyInfo disabled it also skips [SupportedOSPlatform("windows")]
       for the -windows TFM, and every WinForms call then trips CA1416. -->
  <PropertyGroup>
    <AssemblyTitle>ImageStore</AssemblyTitle>
    <Product>ImageStore</Product>
    <Company>SecretNest.info</Company>
    <Copyright>Copyright © SecretNest.info 2018</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Formerly checked-in dlls built from a fork. Upstream absorbed the
         ImageStore-specific GetCrossCorrelation overloads, so the official
         package is now a drop-in replacement. -->
    <PackageReference Include="Shipwreck.Phash" Version="0.5.0" />
    <PackageReference Include="Shipwreck.Phash.Bitmaps" Version="0.5.0" />

    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />

    <!-- Reference assemblies only. The PowerShell host supplies the real
         implementation at run time; shipping ours would be dead weight at best.
         "native" matters as much as "runtime" here: excluding only the latter
         still drags in the host's native payload — pwrshplugin.dll,
         PowerShell.Core.Instrumentation.dll, and libpsl-native for Linux and
         macOS, in a Windows-only module. -->
    <PackageReference Include="System.Management.Automation" Version="7.6.5"
                      ExcludeAssets="runtime;native" />
  </ItemGroup>

</Project>
