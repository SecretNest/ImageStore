<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- No Windows Forms here, so plain net10.0: the tool only moves rows between
         two databases and can run wherever both are reachable. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SecretNest.ImageStore.Migrator</RootNamespace>
    <AssemblyName>ImageStore.Migrator</AssemblyName>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads the old database, writes the new one. This is the only project that
         still references SqlClient; the module itself no longer does. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked, not copied. A migrated database and a freshly created one must have
         exactly the same schema, and two copies of these statements would eventually
         disagree. -->
    <Compile Include="..\ImageStore\Database\SqliteSchema.cs" Link="SqliteSchema.cs" />
  </ItemGroup>

</Project>
